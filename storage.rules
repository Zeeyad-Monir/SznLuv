rules_version = '2';

// SznLuv Storage rules: spot and profile photos.
//
// Not deployed automatically, like firestore.rules. Deploy both together: these rules ask Firestore
// which photos are shared (the first deploy asks to let Storage read Firestore; allow it).
//
// Tested by tests/rules/storage.rules.test.cjs against the emulator (npm run test:rules).
service firebase.storage {
  match /b/{bucket}/o {
    // spotPhotos/{ownerUid}/{spotId}/{photoId}. A spot's ID starts with its owner's uid.
    match /spotPhotos/{uid}/{spotId}/{photoId} {
      // The owner always. Anyone signed in only while the spot is in a public list, which is exactly
      // while publicSpots/{spotId} exists: making the list private takes the photos with it.
      allow read: if request.auth != null
        && (request.auth.uid == uid
          || firestore.exists(/databases/(default)/documents/publicSpots/$(spotId)));
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && spotId.matches(uid + '_.+')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /profilePhotos/{uid}/{fileName} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isCurrentPhoto() {
        let path = /databases/(default)/documents/profiles/$(uid);
        return firestore.exists(path) && fileName == firestore.get(path).data.get('avatarPhotoId', '') + '.jpg';
      }

      // Uploads are immutable. Publishing points the profile at a new ID; old IDs lose visitor access.
      allow get: if request.auth != null && (isOwner() || isCurrentPhoto());
      allow create: if isOwner()
        && resource == null
        && fileName.matches('^[a-zA-Z0-9]{20}[.]jpg$')
        && request.resource.size > 0 && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isOwner();
    }
  }
}
