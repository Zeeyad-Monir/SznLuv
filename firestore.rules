rules_version = '2';

// SznLuv Firestore rules.
//
// Not deployed automatically. Before publishing, export the rules currently live on the
// `sznluv` project and compare: this file is written to replace them, and it closes the
// hole described in docs/FIRESTORE_OWNERSHIP_FIX.md (any signed-in user could read and
// edit another user's favourites).
//
// Tested by tests/rules/*.test.cjs against the emulator (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function shortText(value, max) {
      return value is string && value.size() <= max;
    }

    function publicList(listId) {
      return /databases/$(database)/documents/publicLists/$(listId);
    }

    function followersBefore(listId) {
      return get(publicList(listId)).data.get('followerCount', 0);
    }

    function followersAfter(listId) {
      return getAfter(publicList(listId)).data.get('followerCount', 0);
    }

    function followPointer(listId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/followedLists/$(listId);
    }

    // ---------------------------------------------------------------- Private, per user

    // Profile check at sign-in, username, Top 4 draft, blocked list.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /votes/{reviewId} {
        allow read, write: if isOwner(uid);
      }
      // Following a list also moves its public followerCount by one, in the same write (see publicLists).
      match /followedLists/{listId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && exists(publicList(listId))
          && request.resource.data.publishedAt == get(publicList(listId)).data.publishedAt
          && followersAfter(listId) == followersBefore(listId) + 1;
        // Only "opened": the pointer's publishedAt is what ties it to the count. A missing pointer is left
        // for Firestore to answer "not found".
        allow update: if isOwner(uid)
          && (resource == null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastOpenedAt']));
        // A stale pointer (list gone, or withdrawn and published again) goes without touching any count.
        allow delete: if isOwner(uid)
          && (!exists(publicList(listId))
            || get(publicList(listId)).data.publishedAt != resource.data.publishedAt
            || followersAfter(listId) == followersBefore(listId) - 1
            || (followersBefore(listId) == 0 && followersAfter(listId) == 0));
      }
      match /followedPeople/{otherUid} {
        allow read, write: if isOwner(uid);
      }
      // Collections kept with a heart (a city's season, or a later category). The document ID is the
      // collection ID, so a collection can only be kept once.
      match /savedCollections/{collectionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.collectionId == collectionId
          && request.resource.data.keys().hasOnly(['collectionId', 'cityId', 'savedAt']);
      }
    }

    // Season hearts (and, until migrated, legacy collections).
    match /favourites/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Username reservations. Old documents also hold an email, so they can be fetched
    // by exact name during signup but never listed.
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------- Lists

    // Titles are capped at 25. Lists named before that (up to 40) keep their title until it is changed:
    // `oldTitle` is the title already saved there (or on the owner's draft, for the public copy).
    function validTitle(data, oldTitle) {
      return data.title is string && data.title.size() > 0
        && (data.title.size() <= 25 || (data.title.size() <= 40 && data.title == oldTitle));
    }

    function validListFields(data) {
      return data.title is string
        && shortText(data.description, 120)
        && data.cityId is string
        && data.cover is map
        && data.items is list && data.items.size() <= 50;
    }

    // The owner's working copy. Nobody else can read it, public or not.
    match /lists/{listId} {
      allow get: if signedIn() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validListFields(request.resource.data)
        && validTitle(request.resource.data, null);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validListFields(request.resource.data)
        && validTitle(request.resource.data, resource.data.title);
      allow delete: if signedIn() && (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    // What visitors see. Written only by publishing from a list the writer owns.
    // followerCount ranks "From the community". Publishing keeps it as it is; anyone else can only move
    // it by one, together with creating or deleting their own follow pointer.
    match /publicLists/{listId} {
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
        && ((request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1
              && !exists(followPointer(listId)) && existsAfter(followPointer(listId)))
          || (request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1
              && resource.data.get('followerCount', 0) >= 1
              && exists(followPointer(listId)) && !existsAfter(followPointer(listId))));
      allow create, update: if signedIn()
        && request.resource.data.get('followerCount', 0) == (resource == null ? 0 : resource.data.get('followerCount', 0))
        && request.resource.data.ownerUid == request.auth.uid
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && get(/databases/$(database)/documents/lists/$(listId)).data.ownerUid == request.auth.uid
        && request.resource.data.ownerUsername == myUsername()
        && validListFields(request.resource.data)
        && validTitle(request.resource.data, get(/databases/$(database)/documents/lists/$(listId)).data.title)
        && request.resource.data.items.size() >= 1
        && request.resource.data.searchTerms is list
        && request.resource.data.searchTerms.size() <= 120;
      // Deleting a list that was never public also clears this path, so "nothing there" is allowed.
      allow delete: if signedIn() && (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    // ---------------------------------------------------------------- Spots people make

    // A spot's ID starts with its owner's uid ("{uid}_{suffix}"), so ownership is checked from the path
    // alone: no reads, however many spots one write touches.
    function ownsSpotId(spotId) {
      return signedIn() && spotId.matches(request.auth.uid + '_.+');
    }

    function validSpotFields(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && (!('description' in data) || shortText(data.description, 500))
        && (!('tips' in data) || shortText(data.tips, 300))
        && (!('cost' in data) || shortText(data.cost, 60))
        && (!('hours' in data) || shortText(data.hours, 120))
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 3))
        && (!('publicListIds' in data) || data.publicListIds is list);
    }

    // The owner's record of a spot they made. Nobody else can read it, whatever lists it is in.
    match /spots/{spotId} {
      // Asking for one of your own that isn't there is allowed, so "gone" and "not yours" differ.
      allow get: if ownsSpotId(spotId) && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if ownsSpotId(spotId)
        && request.resource.data.ownerUid == request.auth.uid
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && validSpotFields(request.resource.data);
      allow delete: if ownsSpotId(spotId);
    }

    function sharedSpot(spotId) {
      return exists(/databases/$(database)/documents/publicSpots/$(spotId));
    }

    // What others see of a spot: it exists only while the spot is in at least one of its owner's public
    // lists (services/lists.js writes and deletes it with the list's public copy).
    match /publicSpots/{spotId} {
      allow read: if signedIn();
      allow create, update: if ownsSpotId(spotId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUsername == myUsername()
        && validSpotFields(request.resource.data)
        && !('publicListIds' in request.resource.data);
      // By the owner, even if their record of the spot is already gone.
      allow delete: if ownsSpotId(spotId);

      // One set of reviews per spot, whichever public lists it is in. While the spot isn't shared they
      // are kept but only its owner can read them (to know a reviewed spot can't be moved far).
      match /reviews/{reviewId} {
        allow read: if signedIn() && (ownsSpotId(spotId) || sharedSpot(spotId));
        allow create: if signedIn()
          && sharedSpot(spotId)
          && !ownsSpotId(spotId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username == myUsername()
          && request.resource.data.placeID == 'x:' + spotId
          && request.resource.data.thumbsUpCount == 0
          && request.resource.data.starRating is number
          && request.resource.data.starRating >= 1 && request.resource.data.starRating <= 5
          && shortText(request.resource.data.comment, 2000);
        allow update: if signedIn()
          && sharedSpot(spotId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thumbsUpCount'])
          && request.resource.data.thumbsUpCount == resource.data.get('thumbsUpCount', 0) + 1;
        // Its author, or the spot's owner as moderator of their own page.
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || ownsSpotId(spotId));
      }
    }

    // ---------------------------------------------------------------- Public profiles

    // Only what a user has chosen to show: username, avatar, bio, public Top 4.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.username == myUsername()
        && (!('bio' in request.resource.data) || shortText(request.resource.data.bio, 80))
        && (!('avatarPhotoId' in request.resource.data) || (
          request.resource.data.avatarPhotoId is string && request.resource.data.avatarPhotoId.matches('^[a-zA-Z0-9]{20}$')
        ))
        && (!('top4' in request.resource.data) || request.resource.data.top4 is map);
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------- Moderation

    // Reports are write-once and read only from the Firebase console.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['list', 'person', 'spot', 'review']
        && request.resource.data.targetId is string
        && shortText(request.resource.data.reason, 40);
      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------------- Explore recommendations

    // What one app session saw and did on Explore, written once and never read back by anyone. The daily
    // function (functions/handlers.js) counts these and deletes them. `at` is the server's clock, and the
    // writer can only speak for themselves.
    match /events/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'at', 'session', 'algo', 'items'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 60
        && shortText(request.resource.data.session, 40)
        && shortText(request.resource.data.algo, 20);
      allow read, update, delete: if false;
    }

    // Written and read by Cloud Functions only; the app gets its feed from the getExploreFeed function.
    match /exploreIndex/{shardId} {
      allow read, write: if false;
    }

    match /exploreMetrics/{day} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- Existing shared data

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.thumbsUpCount == 0
        && request.resource.data.placeID is string
        && request.resource.data.starRating is number
        && request.resource.data.starRating >= 1 && request.resource.data.starRating <= 5
        && shortText(request.resource.data.comment, 2000);
      // An upvote: the count goes up by exactly one and nothing else changes.
      // One vote per user is enforced by the transaction with users/{uid}/votes.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thumbsUpCount'])
        && request.resource.data.thumbsUpCount == resource.data.get('thumbsUpCount', 0) + 1;
      // Reviews carry a username, not a uid, so that is the only ownership signal.
      allow delete: if signedIn() && resource.data.username == myUsername();
    }

    match /dateCounts/{season} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
