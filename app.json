{
  "expo": {
    "name": "SznLuv",
    "slug": "SznLuv",
    "scheme": "sznluv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeeyad.sznluv",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SznLuv uses your location to find nearby date spots and show directions to venues.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Your app requires location access for enhanced navigation features.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zeeyad.sznluv",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "WEATHER_API_KEY": "92be9d8cdbac2f4865e8666ae541f316",
      "eas": {
        "projectId": "120aa27a-b201-4e87-ac33-e969768fd147"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SznLuv uses your photos so you can add a profile picture or pictures to spots you make.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-asset"
    ],
    "owner": "zeeyad_monir"
  }
}
